<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF17181A"
    android:paddingStart="56dp"
    android:paddingTop="36dp"
    android:paddingEnd="56dp"
    android:paddingBottom="36dp">

    <TextView
        android:id="@+id/scale_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/zoom"
        android:textColor="#FFF1F3F4"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/scale_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/display_scale_summary"
        android:textColor="#FF9AA0A6"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scale_title" />

    <FrameLayout
        android:id="@+id/preview_frame"
        android:layout_width="440dp"
        android:layout_height="248dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/display_modern_preview_frame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scale_summary">

        <View
            android:id="@+id/preview_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/display_modern_preview_inner" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/scale_controls"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/display_modern_card_bg"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preview_frame">

        <LinearLayout
            android:id="@+id/scale_horizontal_row"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/display_modern_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/display_scale_horizontal"
                android:textColor="#FFF1F3F4"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/scale_horizontal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="true"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:nextFocusDown="@id/scale_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:progressDrawable="@drawable/display_modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/display_modern_seekbar_thumb" />

            <TextView
                android:id="@+id/scale_horizontal_value"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF8AB4F8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scale_vertical_row"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/display_modern_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/display_scale_vertical"
                android:textColor="#FFF1F3F4"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/scale_vertical"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:focusable="true"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:nextFocusDown="@id/scale_reset"
                android:nextFocusUp="@id/scale_horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:progressDrawable="@drawable/display_modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/display_modern_seekbar_thumb" />

            <TextView
                android:id="@+id/scale_vertical_value"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF8AB4F8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scale_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scale_controls">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/scale_reset"
            android:layout_width="168dp"
            android:layout_height="52dp"
            android:background="@drawable/display_modern_button_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@id/scale_done"
            android:nextFocusUp="@id/scale_vertical"
            android:stateListAnimator="@null"
            android:text="@string/display_scale_reset"
            android:textColor="@color/display_modern_button_text"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/scale_done"
            android:layout_width="168dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/display_modern_button_primary_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/scale_reset"
            android:nextFocusUp="@id/scale_vertical"
            android:stateListAnimator="@null"
            android:text="@string/display_scale_done"
            android:textColor="#FF202124"
            android:textSize="18sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
