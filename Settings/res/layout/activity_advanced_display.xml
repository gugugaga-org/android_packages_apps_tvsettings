<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF17181A"
    android:paddingStart="56dp"
    android:paddingTop="36dp"
    android:paddingEnd="56dp"
    android:paddingBottom="36dp">

    <TextView
        android:id="@+id/advanced_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/advance_settings"
        android:textColor="#FFF1F3F4"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/advanced_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/advanced_display_summary"
        android:textColor="#FF9AA0A6"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/advanced_title" />

    <LinearLayout
        android:id="@+id/advanced_card"
        android:layout_width="720dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/display_modern_card_bg"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/advanced_summary">

        <LinearLayout
            android:id="@+id/brightness_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/display_modern_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/brightness"
                android:textColor="#FFF1F3F4"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/brightness"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:nextFocusDown="@id/contrast"
                android:focusable="true"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:progressDrawable="@drawable/display_modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/display_modern_seekbar_thumb" />

            <TextView
                android:id="@+id/brightness_value"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF8AB4F8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contrast_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/display_modern_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/contrast"
                android:textColor="#FFF1F3F4"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/contrast"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:nextFocusDown="@id/saturation"
                android:nextFocusUp="@id/brightness"
                android:focusable="true"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:progressDrawable="@drawable/display_modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/display_modern_seekbar_thumb" />

            <TextView
                android:id="@+id/contrast_value"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF8AB4F8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/saturation_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/display_modern_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/saturation"
                android:textColor="#FFF1F3F4"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/saturation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:nextFocusDown="@id/tone"
                android:nextFocusUp="@id/contrast"
                android:focusable="true"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:progressDrawable="@drawable/display_modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/display_modern_seekbar_thumb" />

            <TextView
                android:id="@+id/saturation_value"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF8AB4F8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tone_row"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/display_modern_row_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/tone"
                android:textColor="#FFF1F3F4"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/tone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:nextFocusDown="@id/preset_reset"
                android:nextFocusUp="@id/saturation"
                android:focusable="true"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:progressDrawable="@drawable/display_modern_seekbar_progress"
                android:splitTrack="false"
                android:thumb="@drawable/display_modern_seekbar_thumb" />

            <TextView
                android:id="@+id/tone_value"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FF8AB4F8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/preset_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/advanced_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/advanced_display_preset"
            android:textColor="#FF9AA0A6"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/preset_reset"
            android:layout_width="132dp"
            android:layout_height="48dp"
            android:background="@drawable/display_modern_button_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@id/preset_cold"
            android:nextFocusUp="@id/tone"
            android:stateListAnimator="@null"
            android:text="@string/bcsh_reset"
            android:textColor="@color/display_modern_button_text"
            android:textSize="17sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/preset_cold"
            android:layout_width="132dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/display_modern_button_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/preset_reset"
            android:nextFocusRight="@id/preset_warm"
            android:nextFocusUp="@id/tone"
            android:stateListAnimator="@null"
            android:text="@string/bcsh_cold"
            android:textColor="@color/display_modern_button_text"
            android:textSize="17sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/preset_warm"
            android:layout_width="132dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/display_modern_button_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/preset_cold"
            android:nextFocusRight="@id/preset_sharp"
            android:nextFocusUp="@id/tone"
            android:stateListAnimator="@null"
            android:text="@string/bcsh_warm"
            android:textColor="@color/display_modern_button_text"
            android:textSize="17sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/preset_sharp"
            android:layout_width="132dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/display_modern_button_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/preset_warm"
            android:nextFocusUp="@id/tone"
            android:stateListAnimator="@null"
            android:text="@string/bcsh_sharp"
            android:textColor="@color/display_modern_button_text"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/advanced_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preset_row">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/advanced_cancel"
            android:layout_width="168dp"
            android:layout_height="52dp"
            android:background="@drawable/display_modern_button_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@id/advanced_confirm"
            android:nextFocusUp="@id/preset_cold"
            android:stateListAnimator="@null"
            android:text="@string/advanced_display_cancel"
            android:textColor="@color/display_modern_button_text"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/advanced_confirm"
            android:layout_width="168dp"
            android:layout_height="52dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/display_modern_button_primary_bg"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/advanced_cancel"
            android:nextFocusUp="@id/preset_warm"
            android:stateListAnimator="@null"
            android:text="@string/advanced_display_confirm"
            android:textColor="#FF202124"
            android:textSize="18sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
